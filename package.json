{
  "name": "prayerstride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/expo-start.mjs lan",
    "start:tunnel": "node scripts/expo-start.mjs tunnel",
    "start:localhost": "node scripts/expo-start.mjs localhost",
    "eas-build-pre-install": "node scripts/eas-preflight.mjs && node scripts/ensure-scene-assets.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "build:android:apk": "node scripts/ensure-scene-assets.mjs && node scripts/build-android-release.mjs",
    "test:worker": "node scripts/worker-smoke.mjs",
    "test:worker:routes": "node scripts/worker-route-contract.mjs",
    "test:server": "node scripts/server-smoke.mjs",
    "test:scenes": "node scripts/scene-assets-smoke.mjs",
    "audit:screens": "node scripts/screen-audit.mjs",
    "test:rules": "node scripts/run-rules-smoke.mjs",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:storage": "firebase deploy --only storage",
    "purge:encouragements": "node scripts/purge-encouragements.mjs",
    "purge:encouragements:execute": "node scripts/purge-encouragements.mjs --execute",
    "purge:following": "node scripts/purge-following.mjs",
    "purge:following:execute": "node scripts/purge-following.mjs --execute",
    "d1:migrate:local": "npx wrangler d1 migrations apply prayerstride-db-dev --local --env development",
    "d1:migrate:dev": "npx wrangler d1 migrations apply prayerstride-db-dev --remote --env development",
    "d1:migrate:production": "npx wrangler d1 migrations apply prayerstride-db --remote --env=\"\"",
    "d1:backfill": "node scripts/d1-backfill.mjs",
    "d1:backfill:execute": "node scripts/d1-backfill.mjs --execute",
    "d1:backfill:remote": "node scripts/d1-backfill.mjs --execute --remote",
    "d1:backfill:production": "node scripts/d1-backfill.mjs --execute --remote --production",
    "deploy:worker": "npx wrangler deploy --env=\"\"",
    "deploy:worker:production": "npx wrangler deploy --env=\"\"",
    "deploy:backend": "npm run deploy:worker && npm run deploy:firestore && npm run deploy:storage",
    "test": "npm run test:worker && npm run test:worker:routes && npm run test:server && npm run test:scenes && npm run test:unit",
    "test:ci": "npm run test && npm run test:rules",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:performance": "vitest run src/test/performance",
    "test:all": "npm run test:unit && npm run test:performance && npm run test:rules",
    "test:restored": "npm run test:ci && npm run audit:screens && node scripts/restored-feature-smoke.mjs && npx expo export --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.18",
    "firebase": "^12.13.0",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.6",
    "babel-preset-expo": "~54.0.11",
    "jsdom": "^29.1.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "8.5.14",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
