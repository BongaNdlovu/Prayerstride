{
  "name": "prayerstride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "set EXPO_UNSTABLE_HEADLESS=1&& expo start --host lan",
    "start:tunnel": "set EXPO_UNSTABLE_HEADLESS=1&& expo start --tunnel",
    "start:localhost": "set EXPO_UNSTABLE_HEADLESS=1&& expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "test:visual": "node scripts/visual-smoke.mjs",
    "test:flow": "node scripts/flow-smoke.mjs",
    "test:worker": "node scripts/worker-smoke.mjs",
    "test:logic": "node scripts/logic-smoke.mjs",
    "test:ui": "node scripts/ui-source-smoke.mjs",
    "audit:screens": "node scripts/screen-audit.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/rules-smoke.mjs\"",
    "test": "npm run test:flow && npm run test:logic && npm run test:worker && npm run test:ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:component": "vitest run src/components",
    "test:integration": "vitest run src/test/integration",
    "test:performance": "vitest run src/test/performance",
    "test:data": "vitest run src/test/data",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance && npm run test:data",
    "test:restored": "npm run test && node scripts/restored-feature-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/push-notifications": "^8.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^55.0.24",
    "expo-constants": "^55.0.16",
    "expo-device": "^55.0.17",
    "expo-linking": "~55.0.15",
    "expo-notifications": "^55.0.23",
    "expo-router": "^55.0.14",
    "expo-status-bar": "^55.0.6",
    "firebase": "^12.13.0",
    "lucide-react": "^0.460.0",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.6",
    "autoprefixer": "^10.4.19",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
