{
  "name": "prayerstride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "set EXPO_UNSTABLE_HEADLESS=1&& expo start --host lan",
    "start:tunnel": "set EXPO_UNSTABLE_HEADLESS=1&& expo start --tunnel",
    "start:localhost": "set EXPO_UNSTABLE_HEADLESS=1&& expo start --localhost",
    "eas-build-pre-install": "node scripts/eas-preflight.mjs && node scripts/ensure-scene-assets.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "test:worker": "node scripts/worker-smoke.mjs",
    "test:scenes": "node scripts/scene-assets-smoke.mjs",
    "audit:screens": "node scripts/screen-audit.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/rules-smoke.mjs\"",
    "test": "npm run test:worker && npm run test:scenes && npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest watch",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:performance": "vitest run src/test/performance",
    "test:all": "npm run test:unit && npm run test:performance",
    "test:restored": "npm run test:all && node scripts/restored-feature-smoke.mjs && npx expo export --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.13.0",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.6",
    "babel-preset-expo": "~54.0.11",
    "jsdom": "^29.1.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
