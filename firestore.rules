rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /prayers/{prayerId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ["active", "answered"];
      allow update: if isAuthor()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.status in ["active", "answered"];
      allow delete: if isAuthor() || isAdmin();
    }

    match /testimonies/{testimonyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAuthor()
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAuthor() || isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedByUid == request.auth.uid
        && request.resource.data.targetType in ["prayer", "testimony", "user"]
        && request.resource.data.status == "pending";
      allow update: if isAdmin()
        && request.resource.data.status in ["pending", "resolved", "dismissed"];
      allow read, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid;
      allow create, delete: if false;
    }
  }
}
