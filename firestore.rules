rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    function canReadPrayerData(data) {
      return signedIn()
        && (
          isAdmin()
          || data.authorUid == request.auth.uid
          || !("privacy" in data)
          || data.privacy == null
          || data.privacy == "community"
        );
    }

    function canReadPrayerId(prayerId) {
      return exists(/databases/$(database)/documents/prayers/$(prayerId))
        && canReadPrayerData(get(/databases/$(database)/documents/prayers/$(prayerId)).data);
    }

    function notSuspended() {
      return signedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || !("suspended" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.suspended != true);
    }

    function unchanged(keys) {
      return request.resource.data.diff(resource.data).unchangedKeys().hasAll(keys);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    function validString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function optionalString(key, maxLength) {
      return !(key in request.resource.data)
        || request.resource.data[key] == null
        || (request.resource.data[key] is string && request.resource.data[key].size() <= maxLength);
    }

    function optionalBool(key) {
      return !(key in request.resource.data) || request.resource.data[key] is bool;
    }

    function optionalTags(key) {
      return !(key in request.resource.data)
        || request.resource.data[key] == null
        || (request.resource.data[key] is list && request.resource.data[key].size() <= 10);
    }

    function validDateKey(value) {
      return value is string && value.size() == 10;
    }

    function optionalTimestamp(key) {
      return !(key in request.resource.data)
        || request.resource.data[key] == null
        || request.resource.data[key] is timestamp;
    }

    function validCalendarEventCreate() {
      return signedIn()
        && notSuspended()
        && request.resource.data.ownerUid == request.auth.uid
        && validString(request.resource.data.title, 120)
        && validDateKey(request.resource.data.dateKey)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && optionalString("notes", 500)
        && optionalTimestamp("startsAt")
        && optionalTimestamp("endsAt");
    }

    function validCalendarEventUpdate() {
      return signedIn()
        && notSuspended()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validString(request.resource.data.title, 120)
        && validDateKey(request.resource.data.dateKey)
        && request.resource.data.updatedAt is timestamp
        && optionalString("notes", 500)
        && optionalTimestamp("startsAt")
        && optionalTimestamp("endsAt");
    }

    function validCalendarBookmarkCreate(bookmarkId) {
      return signedIn()
        && notSuspended()
        && request.resource.data.keys().hasOnly(["ownerUid", "dateKey", "createdAt"])
        && request.resource.data.keys().hasAll(["ownerUid", "dateKey", "createdAt"])
        && request.resource.data.ownerUid == request.auth.uid
        && bookmarkId == request.auth.uid + "_" + request.resource.data.dateKey
        && validDateKey(request.resource.data.dateKey)
        && request.resource.data.createdAt is timestamp;
    }

    function validUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "role", "owner", "createdAt", "photoURL", "handle", "bio", "registrationState"])
        && request.resource.data.keys().hasAll(["uid", "email", "displayName", "role", "owner", "createdAt", "registrationState"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt is timestamp
        && optionalString("photoURL", 2048)
        && optionalString("handle", 40)
        && optionalString("bio", 180)
        && request.resource.data.role == "user"
        && request.resource.data.owner == false
        && request.resource.data.registrationState == "pending_completion";
    }

    function validUserUpdate() {
      return unchanged(["uid", "email", "role", "owner", "createdAt"])
        && (!("registrationState" in resource.data) || unchanged(["registrationState"]))
        && changedOnly(["displayName", "handle", "bio", "photoURL", "updatedAt"])
        && optionalString("displayName", 80)
        && optionalString("handle", 40)
        && optionalString("bio", 180)
        && optionalString("photoURL", 2048)
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function validPrayerCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly(["title", "body", "authorUid", "authorName", "isAnonymous", "createdAt", "updatedAt", "prayedCount", "status", "privacy", "urgent", "allowShare", "prayerLimit"])
        && request.resource.data.keys().hasAll(["title", "body", "authorUid", "authorName", "isAnonymous", "createdAt", "updatedAt", "prayedCount", "status"])
        && request.resource.data.authorUid == request.auth.uid
        && validString(request.resource.data.title, 120)
        && validString(request.resource.data.body, 2000)
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.isAnonymous is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.prayedCount == 0
        && request.resource.data.status == "active"
        && optionalString("privacy", 24)
        && (!("privacy" in request.resource.data) || request.resource.data.privacy == null || request.resource.data.privacy in ["community", "private"])
        && optionalBool("urgent")
        && optionalBool("allowShare")
        && (!("prayerLimit" in request.resource.data) || request.resource.data.prayerLimit in ["daily", "once", "weekly"]);
    }

    function validPrayerAuthorUpdate() {
      return isAuthor()
        && unchanged(["authorUid", "authorName", "createdAt", "prayedCount"])
        && changedOnly(["title", "body", "isAnonymous", "status", "updatedAt", "privacy", "urgent", "allowShare", "prayerLimit"])
        && request.resource.data.status in ["active", "answered"]
        && validString(request.resource.data.title, 120)
        && validString(request.resource.data.body, 2000)
        && request.resource.data.isAnonymous is bool
        && request.resource.data.updatedAt is timestamp
        && optionalString("privacy", 24)
        && (!("privacy" in request.resource.data) || request.resource.data.privacy == null || request.resource.data.privacy in ["community", "private"])
        && optionalBool("urgent")
        && optionalBool("allowShare")
        && (!("prayerLimit" in request.resource.data) || request.resource.data.prayerLimit in ["daily", "once", "weekly"]);
    }

    function validTestimonyCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly(["title", "body", "authorUid", "authorName", "isAnonymous", "createdAt", "updatedAt", "amen", "praiseGod", "prayerId", "shared", "tags"])
        && request.resource.data.keys().hasAll(["title", "body", "authorUid", "authorName", "isAnonymous", "createdAt", "updatedAt", "amen", "praiseGod"])
        && request.resource.data.authorUid == request.auth.uid
        && validString(request.resource.data.title, 120)
        && validString(request.resource.data.body, 2400)
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.isAnonymous is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.amen == 0
        && request.resource.data.praiseGod == 0
        && optionalString("prayerId", 160)
        && optionalBool("shared")
        && optionalTags("tags");
    }

    function validTestimonyAuthorUpdate() {
      return isAuthor()
        && unchanged(["authorUid", "authorName", "createdAt", "amen", "praiseGod"])
        && changedOnly(["title", "body", "isAnonymous", "shared", "tags", "updatedAt"])
        && validString(request.resource.data.title, 120)
        && validString(request.resource.data.body, 2400)
        && request.resource.data.isAnonymous is bool
        && request.resource.data.updatedAt is timestamp
        && optionalBool("shared")
        && optionalTags("tags");
    }

    function validSessionPrayerLink() {
      return request.resource.data.prayerId == null
        || (validString(request.resource.data.prayerId, 160)
        && canReadPrayerId(request.resource.data.prayerId));
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validUserCreate(uid) && notSuspended();
      allow update: if isSelf(uid) && validUserUpdate() && notSuspended();
      allow delete: if false;

      match /following/{followingId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read, write: if false;
      }
    }

    match /prayers/{prayerId} {
      allow read: if canReadPrayerData(resource.data);
      allow create, update, delete: if false;

      match /prays/{uid} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /testimonies/{testimonyId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn() && notSuspended()
        && request.resource.data.keys().hasOnly(["targetId", "targetType", "reason", "reportedByUid", "status", "createdAt"])
        && request.resource.data.keys().hasAll(["targetId", "targetType", "reason", "reportedByUid", "status", "createdAt"])
        && request.resource.data.reportedByUid == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 160
        && request.resource.data.targetType in ["prayer", "testimony", "user"]
        && validString(request.resource.data.reason, 800)
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp;

      allow read, delete: if isAdmin();

      allow update: if isAdmin()
        && changedOnly(["status"])
        && request.resource.data.status in ["pending", "resolved", "dismissed"];
    }

    match /prayerSessions/{sessionId} {
      allow read: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow create: if signedIn() && notSuspended()
        && request.resource.data.keys().hasOnly(["authorUid", "title", "seconds", "createdAt", "prayerId"])
        && request.resource.data.keys().hasAll(["authorUid", "title", "seconds", "createdAt", "prayerId"])
        && request.resource.data.authorUid == request.auth.uid
        && validString(request.resource.data.title, 140)
        && request.resource.data.seconds is number
        && request.resource.data.seconds > 0
        && request.resource.data.seconds <= 86400
        && request.resource.data.createdAt is timestamp
        && validSessionPrayerLink();
      allow update, delete: if signedIn() && notSuspended()
        && resource.data.authorUid == request.auth.uid
        && unchanged(["authorUid", "createdAt"])
        && changedOnly(["title", "seconds", "prayerId", "updatedAt"])
        && validString(request.resource.data.title, 140)
        && request.resource.data.seconds is number
        && request.resource.data.seconds > 0
        && request.resource.data.seconds <= 86400
        && validSessionPrayerLink();
    }

    match /encouragements/{encouragementId} {
      allow read, write: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow write: if false;
    }

    match /guardianApprovals/{tokenId} {
      allow read, write: if false;
    }

    match /accountDeletionJobs/{uid} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && changedOnly(["read"])
        && request.resource.data.read is bool;

      allow create, delete: if false;
    }

    match /notificationSettings/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) && notSuspended()
        && request.resource.data.keys().hasOnly(["prayerActivity", "testimonyReactions", "pushEnabled", "announcements", "updatedAt"])
        && optionalBool("prayerActivity")
        && optionalBool("testimonyReactions")
        && optionalBool("pushEnabled")
        && optionalBool("announcements")
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);
      allow delete: if false;
    }

    match /calendarEvents/{eventId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if validCalendarEventCreate();
      allow update: if validCalendarEventUpdate();
      allow delete: if signedIn() && notSuspended() && resource.data.ownerUid == request.auth.uid;
    }

    match /calendarBookmarks/{bookmarkId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if validCalendarBookmarkCreate(bookmarkId);
      allow update: if false;
      allow delete: if signedIn() && notSuspended() && resource.data.ownerUid == request.auth.uid;
    }

    match /announcements/{announcementId} {
      allow read: if signedIn()
        && (resource.data.status == "active" || isAdmin());
      allow create, update, delete: if false;
    }

    match /devotions/{devotionId} {
      allow read: if signedIn() && resource.data.status == "active";
      allow write: if false;
    }

    match /studyGuides/{guideId} {
      allow read: if signedIn() && resource.data.status == "active";
      allow write: if false;

      match /lessons/{lessonId} {
        allow read: if signedIn() && resource.data.status == "active";
        allow write: if false;
      }
    }
  }
}
