rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email == "fanelesibonge50@gmail.com";
    }

    function validSelfUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && (
          (isOwnerEmail() && request.resource.data.role == "admin" && request.resource.data.owner == true)
          || (!isOwnerEmail() && request.resource.data.role == "user" && request.resource.data.owner == false)
        );
    }

    function validSelfUserUpdate() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.owner == resource.data.owner;
    }

    function isAuthor() {
      return signedIn() && resource.data.authorUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validSelfUserCreate(uid);
      allow update: if isSelf(uid) && validSelfUserUpdate();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /prayers/{prayerId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status in ["active", "answered"];

      allow update: if isAuthor()
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.status in ["active", "answered"];

      allow delete: if isAuthor() || isAdmin();
    }

    match /testimonies/{testimonyId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;

      allow update: if isAuthor()
        && request.resource.data.authorUid == resource.data.authorUid;

      allow delete: if isAuthor() || isAdmin();
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reportedByUid == request.auth.uid
        && request.resource.data.targetType in ["prayer", "testimony", "user"]
        && request.resource.data.status == "pending";

      allow read, delete: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status"])
        && request.resource.data.status in ["pending", "resolved", "dismissed"];
    }

    match /prayerSessions/{sessionId} {
      allow read: if signedIn() && resource.data.authorUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
    }

    match /encouragements/{encouragementId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["read"])
        && request.resource.data.read is bool;

      allow create, delete: if false;
    }
  }
}
