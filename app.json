{
  "expo": {
    "name": "PrayerStride",
    "slug": "prayerstride",
    "scheme": "prayerstride",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/*",
      "src/assets/**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prayerstride.app"
    },
    "android": {
      "package": "com.lift.prayer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#082A4A"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "b9037650-d868-4974-be17-28e248d5669c"
      },
      "router": {}
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "platemaestros-organization"
  }
}
