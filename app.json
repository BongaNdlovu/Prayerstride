{
  "expo": {
    "name": "PrayerStride",
    "slug": "prayerstride",
    "scheme": "prayerstride",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "jsEngine": "jsc",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prayerstride.app"
    },
    "android": {
      "package": "com.lift.prayer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#082A4A"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "4b845a6a-494d-4868-adaa-fcbd80519edd"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "shakhi"
  }
}
